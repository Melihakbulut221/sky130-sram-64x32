library (sram_64x32) {
  comment                        : "sram_64x32, corner ff_n40C_1v95. Inputs: OpenSTA on the routed periphery plus 0.1 ns guard band. clk falling to dout: post-layout SPICE (minimum over all bits, 30 fF load). min_period = 1.25 x the shortest period that passed in SPICE (4 ns).";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  voltage_map (VPWR, 1.95);
  voltage_map (VGND, 0.0);
  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.95;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
  }
  type ("addr") {
    base_type : array;
    data_type : bit;
    bit_width : 6;
    bit_from : 5;
    bit_to : 0;
  }
  type ("din") {
    base_type : array;
    data_type : bit;
    bit_width : 32;
    bit_from : 31;
    bit_to : 0;
  }
  type ("dout") {
    base_type : array;
    data_type : bit;
    bit_width : 32;
    bit_from : 31;
    bit_to : 0;
  }
  type ("wmask") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("sram_64x32") {
    area : 35100.0;
    dont_touch : true;
    dont_use : true;
    pg_pin("VPWR") { voltage_name : VPWR; pg_type : primary_power; }
    pg_pin("VGND") { voltage_name : VGND; pg_type : primary_ground; }
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      min_period : 5.000;
      min_pulse_width_high : 2.500;
      min_pulse_width_low : 2.500;
      capacitance : 0.0053;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.20778");
	}
	cell_fall(scalar) {
          values("0.15456");
	}
      }
      timing() {
        timing_sense : negative_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.31862");
	}
	cell_fall(scalar) {
          values("1.29533");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.22424");
	}
	cell_fall(scalar) {
          values("0.16974");
	}
      }
      timing() {
        timing_sense : negative_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.33351");
	}
	cell_fall(scalar) {
          values("1.30928");
	}
      }
    }
    pin("en") {
